{
  "name": "mr-accounting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -n api,client -c blue,green \"npm run dev -w api\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently -n api,client -c blue,green \"npm run start -w api\" \"npm run preview -w client\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
